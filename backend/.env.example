# LLM provider — required, settings.py's MODELS dict is wired to Anthropic (ChatAnthropic)
ANTHROPIC_API_KEY=xxx

# LangSmith tracing/observability
LANGSMITH_API_KEY=xxx
LANGSMITH_PROJECT=xxx
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Chroma vector store (optional — only needed if using vectors router)
CHROMA_HOST=api.trychroma.com
CHROMA_TENANT=xxx
CHROMA_TOKEN=xxx
CHROMA_DATABASE=xxx

# Logging
LOG_LEVEL=INFO

# Server port — uncommon port to avoid clashing with other projects on this machine
UVICORN_PORT=8461
