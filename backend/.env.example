# LLM provider (project uses Anthropic per CLAUDE.md — not wired into settings.py yet, see README)
ANTHROPIC_API_KEY=xxx

# Required by boilerplate's settings.py (ChatOpenAI models) — needed to boot until swapped for Anthropic
OPENAI_API_KEY=xxx

# LangSmith tracing/observability
LANGSMITH_API_KEY=xxx
LANGSMITH_PROJECT=xxx
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Chroma vector store (optional — only needed if using vectors router)
CHROMA_HOST=api.trychroma.com
CHROMA_TENANT=xxx
CHROMA_TOKEN=xxx
CHROMA_DATABASE=xxx

# Logging
LOG_LEVEL=INFO
